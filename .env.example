BEDROCK_HOST=localhost
BEDROCK_PORT=19132
BEDROCK_USERNAME=AIBot
BEDROCK_OFFLINE=true
BEDROCK_VERSION=1.26.20
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LOG_LEVEL=info
# POLICY_MODE: explore | shadow | learned | online
#   online  — learned ONNX policy drives the bot with ε-greedy fresh sampling
#             via the Explorer; bot hot-reloads models/policy.onnx whenever the
#             DQN trainer (training/train_dqn.py) rewrites it. Falls back to
#             explore until the first model lands.
POLICY_MODE=online
# Probability of taking an exploration action instead of the policy's argmax
# (only used in POLICY_MODE=online).
ONLINE_EPSILON=0.15
